<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!--
        We do not perform tracking in Apple's sense of the word: no ad
        networks, no third-party analytics, no cross-app identity. The
        session identifier we persist in Keychain is a random 32-char
        device-scoped string; it is never tied to a name, email, phone
        number, Apple ID or the device advertising identifier.
    -->
    <key>NSPrivacyTracking</key>
    <false/>

    <!-- No outbound traffic to any third-party tracking domains. -->
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!--
        Data we collect, by Apple's privacy-label taxonomy.

        Every type is marked LINKED (NSPrivacyCollectedDataTypeLinked =
        true). Apple counts data stored under a user ID as linked to the
        user unless it is de-identified before collection, and ours is all
        stored under the session ID so it can be shown back, synced and
        deleted (AUD-57). "Linked" here means linked to that random ID,
        never to a name, email or account. Not used for tracking. The App
        Store privacy label must say the same (docs/APP_STORE_LISTING.md §3).

        1. User ID — the device-scoped session identifier. Sent to the
           Mercurius backend on every request so conversations can be
           stitched together across sessions on the same device. Never
           tied to a real-world identity; not used for tracking.

        2. Other User Content — the content of chat messages. Sent to
           the Mercurius backend so the LLM (Claude via Anthropic) can
           respond, and stored under the session ID. Used only for app
           functionality; not used for tracking.

        3. Photos or Videos — a photo the student chooses to attach to
           a chat message (via the system PhotosPicker; the app never
           reads the library itself). The photo is uploaded to the
           Mercurius backend and forwarded to Anthropic so Claude can
           respond about it. Used only for app functionality; not used
           for tracking.

        4. Product Interaction — which lessons the student has finished
           or mastered, synced to the Mercurius backend under the session
           identifier so progress survives a reinstall (app
           functionality), and lesson start/finish events used to see
           whether the lessons work (analytics). Not used for tracking.

        Not collected: the age the student picks on first run is used
        once to gate the flow and is never persisted or logged.
    -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeUserID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePhotosorVideos</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeProductInteraction</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
    </array>

    <!--
        Required-reason APIs Apple wants every app to declare when
        called directly by app code. Only one applies to us today:

        UserDefaults (NSPrivacyAccessedAPICategoryUserDefaults):
            Used by SettingsFeature/ThemePreferenceStore,
            CurriculumFeature/ProgressStore and the PersistenceKit stores
            (streak, reminders, last activity, review-prompt counter) to
            persist small on-device state (theme choice, completed
            lessons, reminder times, counters) read only by this app.
            Reason code CA92.1 — "Access info from same app".

        Keychain (Security framework) — not on Apple's required-reason
        list. SecRandomCopyBytes likewise not listed.

        SwiftData / CoreData — any required-reason file-timestamp access
        happens inside Apple's frameworks, which Apple discloses itself;
        app-level manifest only covers what our own code calls directly.
    -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>

</dict>
</plist>
