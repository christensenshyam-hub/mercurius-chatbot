ANTHROPIC_API_KEY=your_anthropic_api_key_here
ALLOWED_ORIGIN=https://yourwebsite.com
PORT=3000

# Standby gamification (mascot: Mercury). OFF by default. Set to 1 to activate
# locally. When off: /api/progression/* returns {"enabled": false}, no
# gamification tables are created, and there is zero change to existing flows.
# Level (XP/engagement) and Rank (credentialed competency) are separate tracks;
# nothing derives rank from XP. See migrations/001_gamification.sql.
GAMIFICATION_ENABLED=false
