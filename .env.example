# ─── Mercurius server: environment reference ───
# server.js loads ./.env via dotenv at boot, so `cp .env.example .env` is the
# local-dev setup. Every variable the server reads is listed here, grouped by
# concern, one comment per variable. Unless the comment says otherwise the
# value shown is the fallback the code uses when the variable is unset, so a
# plain copy of this file gives the default local-dev configuration. Leave a
# value EMPTY (`FOO=`) to keep the code default. dotenv never overrides a
# variable already set in the process environment (Railway's Variables tab).

# ─── Anthropic ───
# Upstream key for @anthropic-ai/sdk. Required unless ANTHROPIC_MOCK=1. Never
# commit a real key; lib/logger.js redacts it from every log line.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Exactly `1` → replace the SDK with the in-process mock (lib/anthropicMock.js):
# no key, no network, no spend. Integration tests and offline UI work run this
# way; the server logs a warning at boot so it can't be mistaken for prod.
ANTHROPIC_MOCK=0
# Which scenario the mock plays: ok | error | overloaded | slow | hang | credit
# (5xx, 529, a stalled stream and credit exhaustion on demand). Empty → ok.
# Only read when ANTHROPIC_MOCK=1.
MOCK_SCENARIO=ok
# Delay (ms) between streamed text deltas from the mock; `slow` multiplies it
# by 20. Only read when ANTHROPIC_MOCK=1.
MOCK_STREAM_DELAY_MS=5
# How long a `hang` scenario waits before failing the way the SDK's client
# timeout would. Only read when ANTHROPIC_MOCK=1.
MOCK_TIMEOUT_MS=30000
# Comma-separated model ids a client may name via `model` on /api/chat; any
# other id is rejected with invalid_model (lib/modelAllowlist.js). Empty →
# this same default.
MODEL_ALLOWLIST=claude-sonnet-4-6,claude-3-5-haiku-latest
# 1/true → every mode is served from the single unified system prompt
# (lib/unifiedPrompt.js). Railway prod runs with it ON; local dev defaults
# OFF — verify prompt changes under both.
USE_UNIFIED_PROMPT=0
# Stream lifecycle (all ms; empty or 0 → the default shown). Two watchdogs
# replace the old single 45 s timer: an IDLE timer for a wedged upstream and a
# hard cap for a runaway reply — a healthy long lesson turn trips neither.
# Abort a stream that has produced no delta for this long.
STREAM_IDLE_MS=30000
# Hard cap on one stream's total wall time.
STREAM_MAX_MS=150000
# Legacy name for STREAM_MAX_MS (eval/CI overrides); when set it wins. Leave
# it empty.
STREAM_WATCHDOG_MS=
# Interval between SSE `: ping` keepalive comments so school proxies and
# cellular NATs don't drop a quiet connection while the model thinks.
SSE_KEEPALIVE_MS=15000
# On SIGTERM (every Railway deploy) stop accepting model work at once but let
# in-flight streams finish for up to this long before exiting. Set Railway's
# RAILWAY_DEPLOYMENT_DRAINING_SECONDS at least this high (it is in seconds).
DRAIN_TIMEOUT_MS=30000

# ─── HTTP server + logging ───
# Comma-separated CORS allowlist. Empty → any origin is accepted (dev only);
# production MUST set it, e.g.
# https://mayoailiteracy.com,https://www.mayoailiteracy.com
ALLOWED_ORIGIN=
# TCP port to listen on. Railway injects its own value.
PORT=3000
# `production` → info-level logs and strict CORS; `test` → silent logger.
NODE_ENV=development
# pino level: trace|debug|info|warn|error|silent. Empty → info in production,
# debug elsewhere, silent under NODE_ENV=test (keep it empty for `npm test`).
LOG_LEVEL=
# Discord channel webhook for operator alerts — spend cap at 80 %/100 %, kill
# switch flips, per-IP cap trips, boot, Anthropic error bursts (lib/alerts.js).
# Empty → alerts are a silent no-op (correct for dev and CI). A secret: the
# URL embeds a token and is never logged.
DISCORD_WEBHOOK_URL=
# Salt appended to the client IP before it is sha256-hashed for the usage
# ledger, per-IP alerts and logs (lib/claudeCall.js hashIp), so raw addresses
# are never stored. Empty → unsalted hash (fine for dev). Set a long random
# string in production and keep it stable across deploys — rotating it breaks
# continuity of every hashed id in the ledger. Read once at boot.
IP_HASH_SALT=

# ─── Storage ───
# Postgres connection string (Railway-provided in prod). Empty → local SQLite.
DATABASE_URL=
# SQLite file used when DATABASE_URL is empty. Empty → ./mercurius.db beside
# db.js. Tests point this at a temp file.
SQLITE_PATH=
# Where uploaded images are persisted: `db` (bytes in the database, default)
# or a future object-storage driver name (see lib/imageStore.js).
IMAGE_STORAGE_DRIVER=db
# IANA time zone that decides when a "day" rolls over for streaks.
STREAK_TZ=America/New_York

# ─── Admin + feature flags ───
# Gates every /api/admin/* route (x-admin-password header). Empty → admin
# routes always answer 401. Use a random 32+ character string in production.
ADMIN_PASSWORD=
# Standby gamification (mascot: Mercury). OFF by default. Set to 1 to activate
# locally. When off: /api/progression/* returns {"enabled": false}, no
# gamification tables are created, and there is zero change to existing flows.
# Level (XP/engagement) and Rank (credentialed competency) are separate tracks;
# nothing derives rank from XP. See migrations/001_gamification.sql.
GAMIFICATION_ENABLED=false

# ─── Spend + safety rails ───

# Global daily Anthropic spend cap in US dollars (audit P0-A): once the day's priced usage (per-model rates, cache reads 0.1×, writes 1.25× — see lib/pricing) reaches this, every Anthropic-backed route returns 503 until UTC midnight. Unset → 15. 0 → refuse all calls.
DAILY_BUDGET_USD=15

# Claude kill switch (audit P0-B). Set to 1/true to boot with all Anthropic
# calls disabled (routes return 503). Runtime toggling — seconds, no redeploy —
# is the admin endpoint: POST /api/admin/kill-switch {"disabled":true|false}
# with the x-admin-password header. The runtime toggle overrides this env.
CLAUDE_DISABLED=false

# ─── Per-minute rate limits (lib/rateLimiter.js; in-memory, single replica) ───
# Sized for a whole classroom sharing one school NAT address, so a burst of
# students never looks like one abusive client. Per client IP unless noted.
# All /api/* requests per IP per minute.
API_IP_PER_MIN=400
# /api/chat requests per IP per minute.
CHAT_IP_PER_MIN=150
# /api/images uploads per IP per minute.
UPLOAD_IP_PER_MIN=60
# /api/report per client IP — a classroom behind one NAT flagging the same
# reply (the client shows "reported" even on a 429, so size for the room).
REPORT_IP_PER_MIN=60
# /api/chat turns per session id per minute — one student, one device.
SESSION_PER_MIN=10

# ─── Daily quotas + in-flight caps (lib/quotas.js; per UTC day, in-memory) ───
# Per-session and per-address backstops beneath the global daily budget above,
# so one runaway client cannot drain it for every other student. A tripped
# daily quota answers 429 daily_limit until UTC midnight; a tripped in-flight
# cap answers 503 busy with retry-after 60 s. Empty → the default shown;
# 0 → refuse everything.
# Curriculum (lesson) turns one session may take per day.
SESSION_DAILY_LESSON_TURNS=40
# Free-chat turns (incl. helper calls) one session may take per day.
SESSION_DAILY_CHAT_TURNS=60
# Anthropic spend (USD, priced via lib/pricing.js) one session may incur per day.
SESSION_DAILY_USD=0.75
# Image uploads (POST /api/images) one session may make per day.
SESSION_DAILY_IMAGES=20
# Anthropic spend (USD) one client IP may incur per day, summed over sessions.
IP_DAILY_USD=10
# New session ids one client IP may mint per day — curbs rotating the session
# id to dodge the per-session caps.
IP_DAILY_NEW_SESSIONS=60
# Image uploads one client IP may make per day, summed over sessions, and the
# total bytes it may store — the per-session image cap alone is dodged by
# rotating ids, and image bytes land in Postgres.
IP_DAILY_IMAGES=200
IP_DAILY_IMAGE_BYTES=524288000
# Concurrent Claude calls one client IP may hold open at once.
IP_MAX_INFLIGHT=40
# Concurrent Claude calls the whole process will run; beyond this a request
# is refused with 503 busy rather than queued.
MAX_INFLIGHT=80

# ─── Models ───
# The summarizing helpers (quiz, report card, concept map, meeting briefing)
# run on a cheaper model; the tutor, the grader, fact-check and analyze stay
# on the tutor model hard-coded in server.js.
HELPER_MODEL=claude-haiku-4-5

# ─── Scheduler: daily digest + retention sweep (lib/scheduler.js, in-process) ───
# One replica, no cron service. Off under NODE_ENV=test; 0 disables elsewhere.
SCHEDULER_ENABLED=1
# UTC hour after which the daily Discord digest (DAU, lessons, cost, errors)
# is posted once. 13 = 9 am US Eastern in summer.
DIGEST_UTC_HOUR=13
# UTC hour after which the retention sweep runs once a day.
RETENTION_UTC_HOUR=8
# Minors' data is not kept forever. Days (or hours) to keep each kind;
# 0 or "off" disables that purge. Reports are kept 180 days, open or
# resolved (a report quotes a student's turn verbatim).
MESSAGE_RETENTION_DAYS=90
IMAGE_RETENTION_HOURS=24
REPORT_RETENTION_DAYS=180
USAGE_RETENTION_DAYS=400
LESSON_EVENTS_RETENTION_DAYS=400
# Sessions inactive this long are erased (deleteSession cascade), 200 per sweep.
SESSION_RETENTION_DAYS=365

# ─── Eval-only ───
# Put the settled Anthropic usage on the SSE 'complete' frame so
# scripts/eval-pacing.mjs can prove prompt-cache hits. Never set in production.
# EVAL_EXPOSE_USAGE=1
